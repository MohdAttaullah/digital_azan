# Environment variables are read from the service environment, not auto-loaded.
# systemd's EnvironmentFile loads these on the Pi.
AZAN_CONFIG=/home/pi/digital-azan/shared/config.yaml
AZAN_DATA_DIR=/home/pi/digital-azan/shared/data
AZAN_HOST=0.0.0.0
AZAN_PORT=8080
# Optional paired/trusted production speaker. The user service retries connection and selects its sink.
AZAN_BLUETOOTH_MAC=
AZAN_BLUETOOTH_RETRY_SECONDS=15
AZAN_TIMEZONE=Asia/Kolkata
# Custom reverse-proxy hostnames, comma-separated. Private IPs and machine/.local names work by default.
# AZAN_ALLOWED_HOSTS=azan.example.org
# Optional control token. Use HTTPS/VPN beyond a trusted private LAN.
# AZAN_CONTROL_TOKEN=generate-a-long-random-token
# Local development only (never physical audio):
# AZAN_AUDIO_MODE=console
